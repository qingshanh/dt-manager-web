# dt-manager-web 统一环境变量模板。
# 使用方法：复制为项目根目录 .env，并只在 .env 中填写真实配置；不要提交真实 .env。

# 应用版本号，会显示在后端 /health 和前端界面中。
APP_VERSION=0.1.0
APP_COMMIT_SHA=
APP_REPOSITORY=qingshanh/dt-manager-web
APP_UPDATE_BRANCH=main

# 后端运行模式：development、test 或 production。
NODE_ENV=development

# Node.js 最大堆内存限制。小内存 VPS 建议 192 或 256；留空则使用 Node 默认值。
NODE_OPTIONS=--max-old-space-size=192

# Docker 构建使用的 Node 基础镜像。默认使用已验证可响应的 docker.hanxi.cc 代理；如不可用可改回 node:22-alpine 或其他可信镜像源。
DOCKER_NODE_IMAGE=docker.hanxi.cc/library/node:22-alpine

# Docker 构建使用的 nginx 基础镜像。默认使用已验证可响应的 docker.hanxi.cc 代理；如不可用可改回 nginx:1.27-alpine 或其他可信镜像源。
DOCKER_NGINX_IMAGE=docker.hanxi.cc/library/nginx:1.27-alpine

# Docker 构建 helper 使用的 Python 基础镜像。不开启 real/helper profile 时通常不会用到。
DOCKER_PYTHON_IMAGE=docker.hanxi.cc/library/python:3.11-slim

# Docker 构建时 npm 安装依赖使用的 registry。VPS 访问 npmjs 慢时建议保持 npmmirror。
NPM_REGISTRY=https://registry.npmmirror.com

# Docker 构建 helper 时 pip 安装依赖使用的 PyPI 镜像源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 本地后端进程监听端口。
# Docker 后端容器内部端口请使用 BACKEND_INTERNAL_PORT。
PORT=5174

# Docker Compose 暴露到宿主机的后端 API 端口。
BACKEND_PORT=5174

# Docker Compose 中后端容器内部端口，也是前端 nginx 反代目标端口。
BACKEND_INTERNAL_PORT=5174

# Docker Compose 暴露到宿主机的前端 Web 端口。
FRONTEND_PORT=5173

# 本地 Vite 开发服务监听地址，start.ps1 和 npm run dev 会使用。
VITE_DEV_HOST=127.0.0.1

# 本地 Vite 开发服务端口。
VITE_DEV_PORT=5173

# 本地 Vite preview 监听地址。
VITE_PREVIEW_HOST=127.0.0.1

# 本地 Vite preview 端口。
VITE_PREVIEW_PORT=5176

# 本地开发时 Vite 代理到的后端地址；Docker 生产前端通常通过相对路径 /api 访问。
VITE_BACKEND_URL=http://localhost:5174

# 前端显示的版本号；如需与 APP_VERSION 一致，保持相同即可。
VITE_APP_VERSION=0.1.0

# 后端允许跨域访问的前端来源，多个地址用英文逗号分隔。
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SQLite 数据库地址。本地开发默认使用仓库内 dev.db。
# Docker Compose 默认会覆盖为 file:/app/data/dingtone.db，除非你修改 docker-compose.yml。
DATABASE_URL=file:./prisma/dev.db

# 后台登录 JWT 签名密钥，真实使用前必须换成长随机字符串。
JWT_SECRET=replace-with-a-long-random-secret

# JWT 登录有效期，例如 24h 或 7d。
JWT_EXPIRES_IN=24h

# 入库加密密钥，用于账号密码和 direct token 等敏感字段，真实使用前必须更换。
ENCRYPTION_KEY=replace-with-a-32-byte-secret-key

# 旧入库加密密钥，多个用英文逗号分隔。迁移 .env 后如果旧账号 token 解不开，可临时填入旧 ENCRYPTION_KEY。
LEGACY_ENCRYPTION_KEYS=

# 初始/默认管理员用户名。
ADMIN_USERNAME=admin

# 初始/默认管理员密码，真实使用前必须更换。
ADMIN_PASSWORD=change-me-now

# 网关模式：mock 为演示数据，real 为 helper/App 桥接，direct 为导入 dtUserId/token/deviceId 后直连。
DT_GATEWAY_MODE=mock

# 发送给 TalkU/Dingtone 服务端的 App 协议版本。
DT_APP_VERSION=6.3.1
DT_DINGDONG_APP_VERSION=6.5.0

# TalkU/Dingtone direct 主服务地址。
DT_SERVER_IP=139.224.25.197

# TalkU/Dingtone direct 主服务端口。
DT_SERVER_PORT=443

# TalkU/Dingtone direct 备用服务地址。
DT_BACKUP_IP=47.103.133.227

# direct REST 风格请求使用的 HTTP 代理地址；没有代理时留空。
# direct 模式会把 TCP 长连接通过 HTTP CONNECT 代理转发；当前出口 IP 被限制时可填写 http://user:pass@host:port。
DT_PROXY_URL=

# direct socket 模式是否使用 TLS。
DT_DIRECT_USE_TLS=false

# APK 证书签名参数，用于 direct 请求参数构造。
DT_APK_CERTIFICATE_SIGN=cf093a0e6b07dce3c8e05f7d4a9c261c

# real 模式下后端访问 helper 桥接服务的地址。
DT_REAL_BRIDGE_BASE_URL=http://127.0.0.1:5175

# helper 桥接鉴权令牌；留空表示不启用 helper 鉴权。
DT_REAL_BRIDGE_TOKEN=

# 后端调用 helper 桥接服务的超时时间，单位毫秒。
DT_REAL_BRIDGE_TIMEOUT_MS=60000

# 通过 helper 购买号码动作的超时时间，单位毫秒。
DT_HELPER_PURCHASE_TIMEOUT_MS=120000

# 本地 ADB 可执行文件路径，用于 ADB 相关辅助能力；不使用可保持默认或留空。
ADB_PATH=adb

# ADB/helper 流程中 TalkU 的包名。
DT_ADB_DINGTONE_PACKAGE=me.talkyou.app.im

# ADB 启动 TalkU 时使用的主 Activity。
DT_ADB_DINGTONE_MAIN_ACTIVITY=.activity.TalkuSplashActivity

# ADB/helper 流程中 Dingtone/叮咚的包名。
DT_ADB_DINGDONG_PACKAGE=me.dingtone.app.im

# ADB 启动 Dingtone/叮咚时使用的主 Activity。
DT_ADB_DINGDONG_MAIN_ACTIVITY=.activity.SplashActivity

# 短信监听/轮询任务的默认间隔，单位秒。
DEFAULT_MESSAGE_POLL_INTERVAL=30

# 账户资料自动刷新默认间隔，单位秒。
DEFAULT_AUTO_REFRESH_INTERVAL=300

# 监听和运行时操作的默认最大重试次数。
DEFAULT_MAX_RETRY_COUNT=3

# 后端启动后恢复监听任务前的等待时间，单位秒。
DEFAULT_MONITOR_RESTORE_DELAY=10

# 后端日志级别：debug、info、warn 或 error。
LOG_LEVEL=info

# Telegram bot token；留空表示不启用 Telegram 通知和控制。
TELEGRAM_BOT_TOKEN=

# Telegram 默认通知 chat_id。
TELEGRAM_CHAT_ID=

# Telegram API 地址或反向代理地址；留空使用官方 https://api.telegram.org。
TELEGRAM_API_BASE_URL=

# Docker Compose 和本地 helper 使用的 helper 端口。
HELPER_PORT=5175

# helper 监听地址。本地建议 127.0.0.1，Docker 容器内使用 0.0.0.0。
DT_HELPER_BIND_HOST=127.0.0.1

# helper 连接 Frida 的设备模式：usb、local、remote 或 id。
DT_HELPER_DEVICE_MODE=remote

# remote 模式下 Frida server 地址。
DT_HELPER_REMOTE_HOST=127.0.0.1:27042

# id 模式下使用的 Frida 设备 ID。
DT_HELPER_DEVICE_ID=

# helper 自身鉴权令牌；启用时建议与 DT_REAL_BRIDGE_TOKEN 保持一致。
DT_HELPER_TOKEN=

# helper 操作 TalkU 时使用的包名。
DT_HELPER_DINGTONE_PACKAGE=me.talkyou.app.im

# helper 操作 Dingtone/叮咚时使用的包名。
DT_HELPER_DINGDONG_PACKAGE=me.dingtone.app.im

# helper 单次动作超时时间，单位毫秒。
DT_HELPER_TIMEOUT_MS=90000

# helper spawn 应用后等待注入 hook 的时间，单位毫秒。
DT_HELPER_SPAWN_PAUSE_MS=1500
