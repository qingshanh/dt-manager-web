{
    "name":  "dt-manager-backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "node scripts/dev-supervisor.mjs",
                    "dev:watch":  "tsx watch src/index.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/index.js",
                    "verify:direct-session":  "tsx src/scripts/verify-direct-session.ts",
                    "verify:direct-regression":  "tsx src/scripts/verify-direct-regression.ts",
                    "verify:direct-phone-actions":  "tsx src/scripts/verify-direct-phone-actions.ts",
                    "probe:direct-access-code":  "tsx src/scripts/probe-direct-access-code.ts",
                    "import:direct-template":  "tsx src/scripts/import-direct-template.ts",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "dev:raw":  "tsx src/index.ts"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.8.2",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.1.0",
                         "iconv-lite":  "^0.4.24",
                         "jsonwebtoken":  "^9.0.2",
                         "prisma":  "^6.8.2",
                         "zod":  "^3.24.4"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^5.0.1",
                            "@types/jsonwebtoken":  "^9.0.9",
                            "@types/node":  "^22.15.21",
                            "tsx":  "^4.19.4",
                            "typescript":  "^5.8.3"
                        }
}
